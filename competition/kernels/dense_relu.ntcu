// Batched fully connected layer with fused ReLU.
__global__ void dense_relu(float* input, float* weight, float* bias,
                           float* output, int input_count,
                           int output_count, int total_count) {
    int p = blockIdx.x * blockDim.x + threadIdx.x;
    if (p < total_count) {
        int n = p / output_count;
        int co = p % output_count;
        float sum = bias[co];
        for (int i = 0; i < input_count; ++i) {
            sum = fmaf(input[n * input_count + i],
                       weight[co * input_count + i], sum);
        }
        output[p] = fmaxf(sum, 0.0f);
    }
}
