__global__ void saxpy(float* x, float* y, float a, uint n) {
    uint i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) {
        float value = fmaf(a, x[i], y[i]);
        y[i] = value;
    }
}
