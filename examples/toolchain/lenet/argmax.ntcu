// =============================================================================
__global__ void classify(float* input, int* output, int count) {
    float best = input[0];
    int index = 0;
    for (int i = 1; i < count; ++i) {
        float value = input[i];
        if (value > best) {
            best = value;
            index = i;
        }
    }
    output[0] = index;
}
