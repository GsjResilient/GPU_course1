__global__ void dense(float* input, float* weight, float* bias, float* output, int count) {
    int co = threadIdx.x;
    float sum = bias[co];
    for (int i = 0; i < count; ++i) {
        sum = fmaf(input[i], weight[co * count + i], sum);
    }
    output[co] = sum;
}
